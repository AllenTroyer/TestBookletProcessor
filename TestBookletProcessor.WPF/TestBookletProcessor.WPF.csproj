<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
  <OutputType>WinExe</OutputType>
  <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
  <Nullable>enable</Nullable>
  <ImplicitUsings>enable</ImplicitUsings>
  <UseWPF>true</UseWPF>
    
  <!-- Version Information -->
  <Version>1.1.0</Version>
  <AssemblyVersion>1.2.0.0</AssemblyVersion>
  <FileVersion>1.2.0.0</FileVersion>
  <InformationalVersion>1.2.0</InformationalVersion>

  <!-- Application Information -->
  <Product>Test Booklet Processor</Product>
  <Company>Catforms LLC</Company>
  <Copyright>Copyright © 2026</Copyright>
  <Description>Test booklet processing application with QR code scanning and red pixel removal</Description>
    
  <!-- Publishing Configuration -->
  <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  <SelfContained>true</SelfContained>
  <PublishSingleFile>false</PublishSingleFile>
  <IncludeNativeLibrariesForSelfContained>true</IncludeNativeLibrariesForSelfContained>
  <PackageIcon>booklet.png</PackageIcon>
</PropertyGroup>

<ItemGroup>
  <None Include="..\..\..\..\Dropbox\Data\Catforms\Graphics\Logo\booklet.png">
    <Pack>True</Pack>
    <PackagePath>\</PackagePath>
  </None>
</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestBookletProcessor.Core\TestBookletProcessor.Core.csproj" />
    <ProjectReference Include="..\TestBookletProcessor.Services\TestBookletProcessor.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.10" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="WindowsAPICodePack" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties appsettings_1json__JsonSchema="" /></VisualStudio></ProjectExtensions>

</Project>
