{
  "BookletProcessor": {
    "DefaultInputFolder": "C:\\TestBooklets\\Input",
    "DefaultTemplateFolder": "C:\\TestBooklets\\Templates",
    "DefaultOutputFolder": "C:\\TestBooklets\\Output",
    "DefaultDpi": 200,
    "RedPixelThreshold": 90,
    "EnableRedPixelRemover": true,
    "TempFolder": "C:\\temp",
    "QrScanner": {
      "EnableQrScanning": true,
      "QrRegionXInches": 7,
      "QrRegionYInches": 9.5,
      "QrRegionWidthInches": 1.5,
      "QrRegionHeightInches": 1.5,
      "QrValuesExcludingRedRemoval": [ "APT2*-0*", "*CVR", "CLEAN" ]
    },
    "TemplateExclusionPatterns": [ "*TEMPLATE*", "*BLANK*", "*SAMPLE*" ],
    "ScannedSheets": {
      "TemplateName": "Template_ScannedSheets.pdf",
      "QrToPageMapping": {
        "CHECKLISTQR-01": 0,
        "CHECKLISTQR-02": 1,
        "RAWFORMQR-01": 2,
        "RAWFORMQR-02": 3,
        "3100QR-01": 4,
        "3100QR-02": 5,
        "4100QR-01": 6,
        "4100QR-02": 7,
        "5100QR-01": 8,
        "5100QR-02": 9
      }
    },
    "NotImplemented": {
      "OutputPdfPageWidthInches": 8.5,
      "OutputPdfPageHeightInches": 11.0,
      "MaxSkewAngle": 15.0,
      "ImageBlurSize": 5,
      "EdgeDetectionLow": 50,
      "EdgeDetectionHigh": 150,
      "OrbGoodMatches": 50
    }
  }
}
