{
  "BookletProcessor": {
    "MaxConcurrency": 4,
    "DefaultInputFolder": "C:\\TestBooklets\\Input",
    "DefaultTemplateFolder": "C:\\TestBooklets\\Templates",
    "DefaultOutputFolder": "C:\\TestBooklets\\Output",
    "DefaultDpi": 200,
    "RedPixelThreshold": 90,
    "EnableRedPixelRemover": true,
    "TempFolder": "C:\\temp",
    "QrScanner": {
      "EnableQrScanning": true,
      "QrRegionXInches": 7,
      "QrRegionYInches": 9.5,
      "QrRegionWidthInches": 1.5,
      "QrRegionHeightInches": 1.5,
      "QrValuesExcludingRedRemoval": [ "APT2*-0*", "*CVR", "CLEAN" ]
    },
    "TemplateExclusionPatterns": [ "Template_CAT*", "*BLANK*", "*SAMPLE*" ],
    "ScannedSheets": {
      "TemplateName": "Template_ScannedSheets.pdf",
      "QrToPageMapping": {
        "CHECKLISTQR-01": 0,
        "CHECKLISTQR-02": 1,
        "RAWFORMQR-01": 2,
        "RAWFORMQR-02": 3,
        "3100QR-01": 4,
        "3100QR-02": 5,
        "4100QR-01": 6,
        "4100QR-02": 7,
        "5100QR-01": 8,
        "5100QR-02": 9
      },
      "SecondaryQrScan": {
        "TriggerQrCode": "CHECKLISTQR-01",
        "RegionXInches": 0.0,
        "RegionYInches": 0.75,
        "RegionWidthInches": 2.0,
        "RegionHeightInches": 1.0,
        "FileNameReplacementPattern": "SchoolCityState"
      }
    },
    "RedPixelExclusionRegions": [
      {
        "Name": "Handwriting Protection Area",
        "QrCodePatterns": [ "3100QR-01", "4100QR-01", "5100QR-01" ],
        "XInches": 0.0,
        "YInches": 0.0,
        "WidthInches": 5.5,
        "HeightInches": 2.1
      }
    ]
  }
}
